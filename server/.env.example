PORT=5000
# Front-end origin(s) allowed by CORS, comma-separated
CLIENT_ORIGIN=http://localhost:3000
# Base URL of the front end, used in share links
PUBLIC_URL=http://localhost:3000
MONGO_URI=mongodb://localhost:27017/temporary-storage
# Supabase Storage with a bucket named "files"; use the service role key, server only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
# Link lifetime in seconds
TTL_IN_SECONDS=3600
MAX_TTL_IN_SECONDS=86400
MAX_FILE_SIZE_MB=50
MAX_FILES=20
